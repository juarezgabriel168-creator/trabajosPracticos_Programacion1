Algoritmo sin_titulo
	Definir h, m, s Como Entero
	
	escribir "reloj"
	Esperar 1 Segundos
	
	para h = 0 Hasta 23 Hacer
		para m = 0 Hasta 59 Hacer
			para s = 0 hasta 59 hacer 
				
				Borrar Pantalla 
				Escribir "=====reloj====="
				Escribir "    ",h,":",m,":",s 
				esperar 1 Segundos
			FinPara
		FinPara
	FinPara
	
FinAlgoritmo
