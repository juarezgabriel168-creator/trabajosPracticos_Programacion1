Algoritmo AreaDeTrianguloRectangulo
	
	Definir base, altura, area Como Real
	
	Escribir "ingresar valor de base de el triangulo: "
	leer base
	Escribir "ingresar el valor de la altura de el triangulo"
	leer altura
	
	area = base * altura / 2
	Escribir "el area de el triangulo rectancgulo es ", area
FinAlgoritmo
