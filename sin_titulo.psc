Algoritmo sin_titulo
	definir cuadrado, cubo Como Real
	Definir n, i Como Entero
	Escribir "VALOR===AL CUADRADO===AL CUBO"
	para i = 1 hasta 5 Hacer
		Para n = 1 hasta 5 Hacer
			Escribir "  ",n,"           " n*n, "          ", n*n*n
			Escribir "=============================="
			esperar 1 Segundos
		FinPara
	FinPara
	

FinAlgoritmo
